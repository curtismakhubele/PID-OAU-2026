<?xml version="1.0" encoding="utf-8"?>
<!--
  Only used if your Azure Web App runs on Windows (App Service Plan OS = Windows).
  If you chose Linux when creating the Web App (the default, and what the setup guide
  recommends), this file is simply ignored — no harm in it being here either way.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode watchedFiles="web.config;*.js" nodeProcessCommandLine="node.exe" />
  </system.webServer>
</configuration>
